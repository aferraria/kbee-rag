<?xml version="1.0" encoding="UTF-8"?>

<!-- status=OFF [do not log internal log4 status events] monitorInterval=60 
	[reload file every seconds] - -->

<configuration status="OFF" monitorInterval="30">

	<Properties>
		<Property name="log-path">logs</Property>
	</Properties>

	<appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d{MM.dd.yyyy HH:mm:ss.SSS} [%t] %-5level %c{1.} - %msg%n" />
		</Console>

		<RollingFile name="kbeerag"
			fileName="${sys:log-path}/kbeerag.log" immediateFlush="false"
			filePattern="${sys:log-path}/kbeerag-%d{yyyy-MM-dd-HH}.log">
			<PatternLayout
				pattern="%d{MM.dd.yyyy HH:mm:ss.SSS} [%t] %-5level %c{1.} - %msg%n" />
			<Policies>
				<!-- TimeBasedTriggeringPolicy interval="1" modulate="true"/ -->
				<SizeBasedTriggeringPolicy size="1000 MB" />
			</Policies>
			<DefaultRolloverStrategy>
				<!-- * only files in the log folder and 1 level * only rolled over log 
					files (name match) * only files that are 7 days old or older -->
				<Delete basePath="${sys:log-path}" maxDepth="2">
					<IfFileName glob="*.log" />
					<IfLastModified age="7d" />
				</Delete>
			</DefaultRolloverStrategy>
		</RollingFile>


		<!--Startup.log prints all info and error of the StartUp process %logger{36} 
			(immediateFlush="false" is not working) -->

		<RollingFile name="startup"
			fileName="${sys:log-path}/startup.log" immediateFlush="true"
			append="false"
			filePattern="${sys:log-path}/startup-%d{yyyy-MM-dd}.log">
			<PatternLayout
				pattern="%d{MM.dd.yyyy HH:mm:ss.SSS} %-5level - %msg%n" />
			<Policies>
				<TimeBasedTriggeringPolicy interval="1"
					modulate="true" />
				<SizeBasedTriggeringPolicy size="50 MB" />
			</Policies>
			<DefaultRolloverStrategy max="10" />
		</RollingFile>

	</appenders>


	<loggers>

		<!-- =============================================================================================================== -->
		<!-- Root Logger -->

		<Asyncroot level="error">
			<AppenderRef ref="Console" />
			<AppenderRef ref="kbeerag" />
		</Asyncroot>

		<!-- =============================================================================================================== -->
		<!-- Startup. This logger is just used by the services at startup -->

		<Logger name="StartupLogger" level="info" additivity="false">
			<AppenderRef ref="Console" />
			<AppenderRef ref="startup" />
		</Logger>

		<!-- =============================================================================================================== -->

		<Logger name="kbee.rag" level="debug"
			additivity="false">
			<AppenderRef ref="Console" />
			<AppenderRef ref="kbeerag" />
		</Logger>

		<Logger name="org.springframework" level="error"
			additivity="false">
			<AppenderRef ref="Console" />
			<AppenderRef ref="kbeerag" />
		</Logger>

	</loggers>


</configuration>


